{
  "name": "otb-chess-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests (Playwright) for the OTB Chess web app.",
  "scripts": {
    "build:server": "mvn -q -DskipTests package",
    "e2e": "npm run build:server && playwright test",
    "e2e:headed": "npm run build:server && playwright test --headed",
    "e2e:ui": "npm run build:server && playwright test --ui",
    "e2e:debug": "npm run build:server && playwright test --debug",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
